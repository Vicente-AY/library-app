<Window x:Class="library_app.GUI.GuiMenu.UserMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:library_app.GUI.GuiMenu"
        mc:Ignorable="d"
        Title="UserMenu" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tabla -->
            <RowDefinition Height="Auto"/>
            <!-- Tarjetas -->
            <RowDefinition Height="Auto" />
            <!-- Botones Confirmar/cancelar-->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="User Menu" HorizontalAlignment="Center" FontSize="85"/>
        <Button Grid.Row="1" x:Name="btnSearch" Click="BtnSearch_Click"
                Content="Search for an Item" VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                Margin="10"/>

        <Button Grid.Row="2" x:Name="btnReturn" Click="BtnReturnItem_Click"
                Content="Return Items" VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                Margin="10"/>
    </Grid>
</Window>
