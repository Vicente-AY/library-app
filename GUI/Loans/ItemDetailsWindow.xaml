<Window x:Class="library_app.GUI.Loans.ItemDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:library_app.GUI.Loans"
        mc:Ignorable="d"
        Title="ItemDetailsWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="imgCover" Grid.Column="0" Height="300" 
                   VerticalAlignment="Center" Stretch="Uniform"/>

            <ScrollViewer Grid.Column="1" Margin="15,0,0,0">
                <StackPanel x:Name="stkDetails">
                    <TextBlock x:Name="lblItemTitle" FontSize="20"
                               FontWeight="Bold" TextWrapping="Wrap"
                               Margin="0,0,0,15" Foreground="#007ACC"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Button Grid.Row="1" Content="Close" Click="BtnClose_Click"
                Width="120" Height="20" HorizontalAlignment="Center"
                Margin="0,15,0,0" Background="#E0E0E0"
                FontWeight="SemiBold"/>

    </Grid>
</Window>
