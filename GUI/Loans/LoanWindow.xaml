<Window x:Class="library_app.GUI.Loans.LoanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:library_app.GUI.Loans"
        mc:Ignorable="d"
        Title="LoanWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <local:BoolToCardBackgroundConverter x:Key="BoolToCardBackgroundConverter"/>
        <local:RelativePathToImageConverter x:Key="RelativePathToImageConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Filtros -->
            <RowDefinition Height="*"/> <!-- Tarjetas -->
            <RowDefinition Height="Auto" /> <!-- Botones Confirmar/cancelar-->
        </Grid.RowDefinitions>
        
        <!--Filtros-->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">

            <ToggleButton x:Name="Books" Content="Books" 
                Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,10,0"/>
            <ToggleButton x:Name="Films" Content="Films"
                Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,10,0"/>
            <ToggleButton x:Name="Music" Content="Music"
                Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,10,0"/>
            <ToggleButton x:Name="Videogames" Content="Videogames"
                Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,10,0"/>
            <ToggleButton x:Name="Available" Content="Only Available"
                Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,10,0"/>

            <TextBox x:Name="txtSearch" Width="200" Margin="0,0,10,0"
                TextChanged="Filter_Changed" ToolTip="Search by Name">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <Grid VerticalAlignment="Center">
                                            <ScrollViewer x:Name="PART_ContentHost" 
                                                          Focusable="False"
                                                          HorizontalScrollBarVisibility="Hidden"
                                                          VerticalScrollBarVisibility="Hidden"                                                      
                                                          Margin="4,0,0,0"/>

                                            <TextBlock x:Name="PlaceHolderText"
                                                           Text="Search By Name"
                                                           Foreground="Gray"
                                                           Padding="4,0,0,0"
                                                           IsHitTestVisible="False"
                                                           Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="PlaceHolderText" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <ComboBox x:Name="cmbGenre" Width="150" Margin="0,0,10,0" 
                      SelectionChanged="Filter_Changed"/>

        </StackPanel>

        <!--Panel de Tarjetas-->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!--Las tarjetas-->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                            Margin="8" Padding="10" Width="160" Background="{Binding Selected, Converter={StaticResource BoolToCardBackgroundConverter}}">

                            <StackPanel>
                                <Image Source="{Binding item.imageRoute, Converter={StaticResource RelativePathToImageConverter}}"
                                       Height="140" Stretch="Uniform"/>
                                <TextBlock Text="{Binding item.title}"
                                           FontWeight="Bold" TextWrapping="Wrap"
                                           Margin="0,6,0,2"/>
                                <TextBlock Text="{Binding item.creator}"
                                           Foreground="Gray" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding item.availability}"
                                           TextWrapping="Wrap" Margin="0,6,0,2"/>
                                <ToggleButton Content="Select"
                                              IsChecked="{Binding Selected, Mode=TwoWay}"
                                              Margin="0,8,0,0"/>
                            </StackPanel>
                            
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Botones e info-->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!--BackButton-->
            <Button Grid.Column="0" Content="Back" Click="BtnBack_Click" FontSize="15"
                    Height="35" Width="70" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
            
            <!--Info-->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock FontSize="14" VerticalAlignment="Center" Margin="10,0">
                    <Run Text="Selected: " FontWeight="SemiBold"/>
                    <Run x:Name="txtSelectedCount" Text="0" Foreground="#007ACC" FontWeight="Bold"/>
                </TextBlock>

                <TextBlock Text="|" Foreground="Gray" VerticalAlignment="Center" Margin="5,0"/>

                <TextBlock FontSize="14" VerticalAlignment="Center" Margin="10,0">
                    <Run Text="User Active Loans: " FontWeight="SemiBold"/>
                    <Run x:Name="txtActiveLoans" Text="0" Foreground="#E67E22" FontWeight="Bold"/>
                </TextBlock>

                <TextBlock Text="|" Foreground="Gray" VerticalAlignment="Center" Margin="5,0"/>

                <TextBlock FontSize="14" VerticalAlignment="Center" Margin="10,0">
                    <Run Text="Available Loan Slots: " FontWeight="SemiBold"/>
                    <Run x:Name="txtAvailableLoanSlots" Text="0" Foreground="#27AE60" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>

            <!--Loan Button-->
            <Button Grid.Column="2" Content="Checkout" Click="BtnConfirmLoan_Click" FontSize="15"
                    Height="35" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
        </Grid>

    </Grid>
</Window>
