<Window x:Class="LibraryApp.GUI.Login.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryApp.GUI.Login"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <StackPanel>
        <TextBlock Text="Login" FontSize="25" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="User" FontSize="18" HorizontalAlignment="Center"/>
        <TextBox x:Name="txtUser" Padding="3" Margin="0,0,0,20" Width="150"/>
        
        <TextBlock Text="Password" FontSize="18" HorizontalAlignment="Center"/>
        <TextBox x:Name="txtPass" Padding="3" Margin="0,0,0,20" Width="150"/>

        <Button x:Name="btnLogin" Content="Login" Click="BtnLogin_Click" Height="30" Width="100" Margin="0,0,0,20"/>
        <Button x:Name="btnRegister" Content="Register" Click="BtnRegister_Click" Height="30" Width="100" Margin="0,0,0,20"/>

    </StackPanel>
</Window>
